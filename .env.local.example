# Copie ce fichier en .env.local et renseigne les valeurs.
# .env.local est ignoré par git (.gitignore : .env*.local) — aucune de ces
# valeurs ne doit finir dans un commit.

# ─── Anthropic ──────────────────────────────────────────────────
# Console → API keys. Crée une clé DÉDIÉE à cette app, dans un workspace
# à part : c'est ce qui permet de lui donner son propre plafond de dépense
# sans toucher au reste de l'organisation.
ANTHROPIC_API_KEY=
# Le modèle de tous les appels de l'app. Haiku 4.5 par défaut (1 $/M en
# entrée, 5 $/M en sortie) — voir lib/ai/client.ts.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# ─── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings → API → service_role. CONTOURNE RLS : lisible et modifiable sur
# tous les comptes. Un seul appelant légitime dans le code, le webhook
# Stripe (lib/supabase/admin.ts). Jamais de préfixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Outillage local uniquement (npm run db:push, db:backup) — inutile en prod.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=
BACKUP_MIRROR=

# ─── Stripe ─────────────────────────────────────────────────────
# Clé secrète : sk_test_… en développement, sk_live_… en production.
STRIPE_SECRET_KEY=
# L'identifiant du TARIF (price_…), pas du produit. Le montant vit chez
# Stripe : le changer ne demande aucun redéploiement.
STRIPE_PRICE_ID=
# Signature du webhook (whsec_…). En local : `stripe listen --forward-to
# localhost:3000/api/billing/webhook` l'affiche au démarrage. En
# production : Developers → Webhooks → l'endpoint → Signing secret.
# Ce sont DEUX secrets différents — le local ne vaut pas en production.
STRIPE_WEBHOOK_SECRET=

# ─── Cloudflare Turnstile (captcha) ─────────────────────────────
# SANS ELLE, PERSONNE NE PEUT S'INSCRIRE EN PRODUCTION. Le widget refuse
# de se rendre et les trois formulaires (inscription, connexion, renvoi de
# confirmation) affichent « momentanément indisponible ». En développement
# on retombe sur la clé de test Cloudflare, donc le manque ne se voit pas —
# il n'apparaît qu'une fois déployé. Voir lib/auth/turnstile.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# La clé SECRÈTE ne se met pas ici : c'est Supabase qui vérifie le jeton
# (Authentication → Attack Protection → Enable Captcha protection,
# provider « Turnstile »). Un jeton est à usage unique — le valider nous-
# mêmes le consommerait et l'appel Supabase échouerait ensuite.

# ─── Divers ─────────────────────────────────────────────────────
# Sert aux liens de confirmation d'email et aux retours de paiement Stripe.
# EN PRODUCTION, C'EST LE DOMAINE RÉEL. Le repli est http://localhost:3000 :
# oubliée, elle renvoie chaque client vers localhost au retour du paiement
# Stripe (lib/billing/stripe.ts), sans le moindre message d'erreur.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── ElevenLabs (prononciation) ─────────────────────────────────
# Sans cette clé, l'app retombe simplement sur la voix du navigateur :
# rien ne casse, la prononciation est juste moins bonne.
ELEVENLABS_API_KEY=
# UNE VOIX PAR LANGUE : le même comédien lisant du russe puis du français
# sonne faux dans au moins une des deux. Voice Library → filtrer sur la
# langue → Use → copier l'ID. Sans ces variables, le code retombe sur une
# voix préfabriquée qui fonctionne mais n'est native ni de l'une ni de
# l'autre.
ELEVENLABS_VOICE_ID_RU=
ELEVENLABS_VOICE_ID_FR=
# eleven_multilingual_v2 par défaut — le seul modèle correct sur le russe.
ELEVENLABS_MODEL_ID=
